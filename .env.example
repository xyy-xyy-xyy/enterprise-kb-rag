# EnterpriseKB 配置模板
#
# 用法：复制为 .env 后按需修改。.env 已被 .gitignore 忽略，不会进入仓库。
#     cp .env.example .env
#
# 本文件只放占位符，**不要**把真实密钥填进来再提交。

# ============ 必填：通义千问 / DashScope ============
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============ 模型与分块 ============
LLM_MODEL=qwen-plus
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ============ 向量后端：faiss 或 qdrant ============
# faiss：本地文件索引，免 Docker，克隆即跑（默认）
# qdrant：需要 Docker 中的 Qdrant 服务在运行
VECTOR_BACKEND=faiss

# FAISS 索引目录（VECTOR_BACKEND=faiss 时生效）
FAISS_INDEX_PATH=data/faiss_index

# Qdrant 连接参数（VECTOR_BACKEND=qdrant 时生效）
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=enterprise_kb

# 知识库原始文档目录
DOCS_DIR=data/docs

# ============ 检索 ============
# 检索返回的片段数
TOP_K=5

# 混合检索（向量 + BM25，RRF 融合）；false 退回纯向量检索
HYBRID_RETRIEVAL=true

# 召回候选数 = TOP_K × 该倍数，融合后再截断到 TOP_K
HYBRID_CANDIDATE_MULTIPLIER=3

# ============ Reranker 重排（走 DashScope API，不下载本地模型） ============
RERANK_ENABLED=true
RERANK_TOP_N=10
# 注意：gte-rerank 已于 2026-05-30 下线，官方迁移目标为 qwen3-rerank
RERANK_MODEL=qwen3-rerank

# ============ 国密安全层 ============
# 文档是否加密落盘（SM4-CBC，文件后缀 .enc）
# false 时行为与加国密之前完全一致，可用于对照演示与排查问题
ENCRYPT_STORE=true

# 是否按 SM3 内容摘要去重（同一份内容换个文件名上传也能识别）
SM3_DEDUP=true

# SM4 密钥：32 位十六进制（= 16 字节）。留空则回退到下面的密钥文件
# 生成方式：venv\Scripts\python.exe -m app.crypto --gen-key
#
# ⚠️ 生产环境请通过环境变量/密钥管理服务注入，不要写进 .env 后提交，
#    更不要把真实密钥填进本模板文件。密钥泄漏会让加密存储失去意义。
#    密钥一旦丢失，已加密的文档将**无法恢复**，请自行做好备份。
SM4_KEY=

# 密钥文件路径（十六进制文本），相对项目根目录解析
# 该文件已被 .gitignore 忽略
SM4_KEY_FILE=data/.sm4_key

# ============ 多轮对话 ============
# 最多携带的历史轮数（1 轮 = 1 条用户 + 1 条助手）
MAX_HISTORY_TURNS=5
# 单条历史消息的最大字符数，超出截断，避免 prompt 膨胀
MAX_HISTORY_CHARS=500
# 检索前把「那交通费呢」这类追问改写成独立查询；false 时只保留历史进 prompt
MULTITURN_REWRITE=true

# ============ 质量评测（python -m app.eval.run_eval） ============
# 裁判模型：给生成的答案打准确性/相关性/完整性分。
# 刻意可以与 LLM_MODEL 不同 —— 用生成答案的同一个模型给自己打分会有
# self-enhancement bias（模型偏好自己的输出），换个模型当裁判更客观。
JUDGE_MODEL=qwen-max

# 评测时的检索 top-k（独立于线上 TOP_K，便于单独调参）
EVAL_TOP_K=5

# ============ 日志 ============
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
